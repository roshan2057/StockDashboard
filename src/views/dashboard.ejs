<%- include("partials/header", { title }) %>

  <section id="grid" class="p-6 bg-gray-900 min-h-screen">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-5">
      <% stocks.forEach(function(stock) { %>
        <!-- this is  card  -->
        <div key={stock.symbol} class="bg-slate-800 p-4 rounded-lg">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-bold text-[var(--text)]">
              <% if (stock.name.length> 21) { %>
                <%= stock.name.slice(0, 21) %>...
                  <% } else { %>
                    <%= stock.name %>
                      <% } %>
                        (<%= stock.symbol %>)
            </h3>
            <span class="text-lg font-bold text-[var(--text)]">
              <%= stock.holdingDays %> Days
                <span>
                  <% if (stock.change> 0) { %>
                    <span class="text-green-500">▲</span>
                    <% } else { %>
                      <span class="text-red-500">▼</span>
                      <% } %>
                </span>

          </div>
          <div class="border-b border-slate-700"></div>
          <div class="text-lg font-bold">
            <table class="my-3 w-full text-[var(--text)] ">
              <tbody>
                <tr>
                  <td class="">Now:</td>
                  <td class="text-end">Rs.<%= stock.lastPrice.toFixed(2) %>
                  </td>
                </tr>
                <tr class="">
                  <td class="">Buy:</td>
                  <td class="text-end">Rs.<%= stock.buyPrice.toFixed(2) %>
                  </td>
                </tr>
                <tr class="">
                  <td class="">Quantity:</td>
                  <td class="text-end">
                    <%= stock.quantity %> Kitta
                  </td>
                </tr>
                <tr>
                  <td class="">Total Invest:</td>
                  <td class="text-end">
                    Rs.<%= (stock.buyPrice * stock.quantity).toFixed(2) %>
                  </td>
                </tr>
                <tr>
                  <td class="">Profit/Loss:</td>
                  <td
                    class="text-end <%= (stock.lastPrice * stock.quantity - stock.buyPrice * stock.quantity) > 0 ? 'text-green-400' : 'text-red-500' %>">
                    <%= (stock.lastPrice * stock.quantity - stock.buyPrice * stock.quantity).toFixed(2) %>
                  </td>

                </tr>
              </tbody>
            </table>


          </div>

          <div class="my-4">
            <h1 class="text-lg font-bold text-[var(--text)]">PRICE BAR</h1>
            <div class="relative w-full mt-10">
              <div class="relative w-full bg-slate-700 h-4 rounded-full mt-2">
                <div class="bg-green-500 h-4 rounded-full" style="width: <%= stock.progressWidth %>%;"></div>

                <div class="text-sm">
                  <% stock.markers.forEach(marker=> { %>
                    <div class="absolute top-0 w-0.5 h-4 bg-<%= marker.color %>" style="left: <%= marker.position %>;">
                    </div>

                    <div class="absolute -translate-x-1/2 text-xs text-<%= marker.color %> my-1"
                      style="left: <%= marker.position %>;">
                      <div
                        class="absolute bottom-full mb-6 left-1/2 -translate-x-1/2 bg-gray-900 text-xs px-2 py-1 rounded ">
                        Rs.<%= marker.value %>
                      </div>
                      <%= marker.label %>
                    </div>
                    <% }) %>
                </div>


              </div>
            </div>



            <div class="flex items-center justify-between font-bold mt-4">
              <div class="bg-slate-900 p-2 rounded-lg mt-4 mr-2 text-start w-full">
                <h1 class="text-[var(--text)]">Stop Loss</h1>
                <span class="text-red-500">
                  Rs.
                  <%= ((stock.buyPrice * stock.quantity) - (stock.stopLoss * stock.quantity)).toFixed(2) %>
                </span>
              </div>

              <div class="bg-slate-900 p-2 rounded-lg mt-4 mr-2 text-start w-full">
                <h1 class="text-[var(--text)]">Target 1</h1>
                <span class="text-green-500">
                  Rs.
                  <%= ((stock.target1 * stock.quantity) - (stock.buyPrice * stock.quantity)).toFixed(2) %>
                </span>
              </div>

              <div class="bg-slate-900 p-2 rounded-lg mt-4 mr-2 text-start w-full">
                <h1 class="text-[var(--text)]">Target 2</h1>
                <span class="text-green-500">
                  Rs.
                  <%= ((stock.target2 * stock.quantity) - (stock.buyPrice * stock.quantity)).toFixed(2) %>
                </span>
              </div>
            </div>


          </div>
        </div>
        <% }); %>
    </div>

  </section>
  <%- include("partials/footer") %>